---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Fill in your personal details here
const personalInfo = {
  name: "Isidora Kuzmanovska",
  role: "Software Engineer / Student",
  bio: "Passionate about building full-stack web applications and machine learning models. Always learning and building.",
  location: "Skopje, North Macedonia",
  github: "https://github.com/isidoraisidora",
  linkedin: "https://www.linkedin.com/in/isidora-kuzmanovska-1087172a2/",
  email: "isidorakuzmanovska@gmail.com"
};

const experience = [
  {
    role: "Laboratory Teaching Assistant",
    company: "Faculty of Computer Science and Engineering",
    period: "October 2025 - May 2026",
    description: "Working as a Laboratory Teaching Assistant at FCSE was an invaluable learning opportunity that greatly strengthened both my technical foundation and soft skills. Assisting students through coursework forced me to master core concepts from first principles and articulate solutions clearly under pressure. It was a hugely rewarding experience that built my confidence in technical communication, leadership, and collaborative problem-solving."
  },
  {
    role: "Vezilka AI Factory Antenna",
    company: "Faculty of Computer Science and Engineering",
    period: "January 2025 - present",
    description: "As part of a collaborative student team on the Vezilka AI Factory Antenna project, I helped design and build an automated workflow in n8n that transforms raw course materials into structured Jupyter Notebooks (.ipynb). Working closely with my peers allowed us to streamline content pipeline generation by leveraging LLM orchestration and workflow automation tools. This hands-on experience deepened my practical knowledge of AI integration, pipeline automation, and agile team collaboration on complex data engineering tasks."
  }
];

const education = [
  {
    degree: "Faculty of Computer Science and Engineering",
    period: "2023 — Present",
    description: "Studying software engineering principles, systems design, algorithms, and modern application development while building practical projects in web development and AI."
  },
  {
    degree: "SOU Gimnazija Josip Broz Tito - Bitola",
    period: "2019 — 2023",
    description: "Studying in the Natural Sciences and Mathematics track provided me with a rigorous foundation in analytical thinking, advanced mathematics, and systematic problem-solving. It sparked my passion for tackling complex logic challenges and prepared me seamlessly for the technical demands of software engineering."
  }
];

// Fill in your skills
const skillCategories = [
  {
    category: "Languages",
    skills: ["JavaScript", "Python", "Java", "C++", "SQL, C#", "HTML", "CSS"]
  },
  {
    category: "Frameworks & Backend",
    skills: ["Astro", "Spring Boot", "Django", ".NET Core"]
  },
  {
    category: "Tools & DevOps",
    skills: ["Docker", "Git", "Tailwind CSS"]
  }
];

// Fill in your projects
const projects = [
  {
    title: "My First Portfolio Page",
    description: "Made it as homework assignment for my Basics of Web Design course, it was my first ever introduction to web development and I learned a lot about HTML, CSS, and JavaScript. It was a fun project that allowed me to experiment with design and layout.",
    tags: ["HTML", "CSS"],
    githubUrl: "https://github.com/isidoraisidora/isidorakuzmanovska.github.io",
    liveUrl: "https://isidoraisidora.github.io/isidorakuzmanovska.github.io/index.html"
  },
  {
    title: "AI Image Crawler",
    description: "Co-developed a FastAPI-backed Web Programming project centered on an on-demand image crawler that integrates the Pexels API and web scraping to fetch visual content. Processed images through Salesforce’s BLIP model to auto-generate missing alt tags, captions, and searchable metadata.",
    tags: ["Python", "FastAPI", "Web Scraping"],
    githubUrl: "https://github.com/isidoraisidora/image-crawler"
  },
  {
    title: "Movie Recommendation Model",
    description: "Developed an enhanced Content-Based Recommender System using Python, Pandas, and scikit-learn. Engineered text features—overviews, cast, directors, and keywords—from the TMDB 5000 dataset into high-dimensional vectors via CountVectorizer and Cosine Similarity to generate precise film recommendations.",
    tags: ["Python", "Pandas", "scikit-learn"],
    githubUrl: "https://github.com/isidoraisidora/movie-recommender-model",
    liveUrl: "https://isidoraisidora.github.io/movie-recommender-model/v2-movie-recommender/"

  },
  {
    title: "Email Summarizer",
    description: "Developed an automated Python application that fetches weekly emails via the Gmail API, parses and cleans their content, and uses the Groq API (Llama 3.3 70B) to generate structured summaries. Automatically formats and emails a categorized digest (Needs Attention, Important Updates, FYI) back to the user via SMTP.",
    tags: ["Python", "LLMs", "SMTP"],
    githubUrl: "https://github.com/isidoraisidora/email-cleaner"
  },
  {
    title: "Skinventory App",
    description: "Built a multi-project ASP.NET Core (.NET 10) web API for skincare inventory management and product reaction tracking. Integrates a daily Quartz.NET ETL pipeline querying Open Beauty Facts to seed product and ingredient data, custom JWT authentication, an asynchronous System.Threading.Channels queue for email reminders, and PAO-aware expiration tracking.",
    tags: [".NET Core", "C#", "SQLite"],
    githubUrl: "https://github.com/isidoraisidora/skinventory-app"
  }
];
---

<Layout title={`${personalInfo.name} | ${personalInfo.role}`}>
  <main class="portfolio-shell">
    <nav class="portfolio-nav" aria-label="Main navigation">
      <div class="nav-links">
        <a href="#education">Education</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <button class="back-to-top" type="button" aria-label="Back to top">↑</button>

    <section class="hero-panel reveal-section">
      <div class="hero-copy">
        <div class="eyebrow">📍 {personalInfo.location}</div>
        <h1>
          Hi, I'm <span>{personalInfo.name}</span>
        </h1>
        <p class="role">{personalInfo.role}</p>
        <p class="bio">{personalInfo.bio}</p>

        <div class="cta-row">
          <a href={personalInfo.github} target="_blank" rel="noopener noreferrer" class="secondary-button">GitHub</a>
          <a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer" class="secondary-button">LinkedIn</a>
        </div>
      </div>

      <div class="profile-card" aria-label="Profile image placeholder">
        <div class="photo-placeholder">
          <img src="/profile_picture.jpg" alt="Profile" />
        </div>
        <div class="mini-metrics">
          <div>
            <strong>5+</strong>
            <span>projects</span>
          </div>
          <div>
            <strong>∞</strong>
            <span>curiosity</span>
          </div>
        </div>
      </div>
    </section>


        <section id="education" class="content-section reveal-section">
      <div class="section-heading">
        <h2>Education</h2>
        <p>Academic background and the places where I developed my technical foundation.</p>
      </div>

      <div class="experience-list">
        {education.map((item) => (
          <div class="experience-item reveal-item">
            <div class="experience-meta">
              <span class="experience-period">{item.period}</span>
            </div>
            <div>
              <h3>{item.degree}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="experience" class="content-section reveal-section">
      <div class="section-heading">
        <h2>Experience</h2>
        <p>Career highlights, learning milestones, and hands-on engineering work.</p>
      </div>

      <div class="experience-list">
        {experience.map((item) => (
          <div class="experience-item reveal-item">
            <div class="experience-meta">
              <span class="experience-period">{item.period}</span>
              <span class="experience-company">{item.company}</span>
            </div>
            <div>
              <h3>{item.role}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>



    <section id="projects" class="content-section reveal-section">
      <div class="section-heading">
        <h2>Featured Projects</h2>
        <p>A collection of things I've built and experimented with. I like looking at what I miss in my every-day life and try to build something for it.</p>
      </div>

      <div class="projects-grid">
        {projects.map((project) => (
          <div class="reveal-item">
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </section>

    <section class="content-section reveal-section">
      <div class="section-heading">
        <h2>Technologies & Skills</h2>
        <p>Tools and frameworks I work with regularly.</p>
      </div>

      <div class="skills-grid">
        {skillCategories.map((cat) => (
          <div class="skill-card reveal-item">
            <h3>{cat.category}</h3>
            <ul>
              {cat.skills.map((skill) => (
                <li>
                  <span></span>
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="contact" class="content-section reveal-section">
      <div class="section-heading">
        <h2>Contact</h2>
        <p>Feel free to reach out for projects, collaborations, or opportunities.</p>
      </div>

      <div class="contact-card reveal-item">
        <div class="contact-row">
          <span class="contact-label">Email</span>
          <a href={`mailto:${personalInfo.email}`}>{personalInfo.email}</a>
        </div>
        <div class="contact-row">
          <span class="contact-label">GitHub</span>
          <a href={personalInfo.github} target="_blank" rel="noopener noreferrer">github.com/isidoraisidora</a>
        </div>
        <div class="contact-row">
          <span class="contact-label">LinkedIn</span>
          <a href={personalInfo.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/isidora-kuzmanovska</a>
        </div>
        <div class="contact-actions">
          <a href="/CV-Isidora-Kuzmanovska.pdf" target="_blank" rel="noopener noreferrer" class="secondary-button">Download CV</a>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {personalInfo.name}. Built with Astro & Tailwind CSS.</p>
      <div class="footer-links">
        <a href={personalInfo.github}>GitHub</a>
        <a href={personalInfo.linkedin}>LinkedIn</a>
      </div>
    </footer>
  </main>

  <style>
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeUpReveal {
      from {
        opacity: 0;
        transform: translateY(28px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes floatIn {
      from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    html {
      scroll-behavior: smooth;
    }

    body,
    .portfolio-shell,
    .nav-links a,
    .bio,
    .experience-item p,
    .section-heading p,
    .contact-row a,
    .site-footer {
      font-family: "Manrope", "Segoe UI", sans-serif;
    }

    .portfolio-shell {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px 64px;
    }

    .portfolio-nav {
      position: sticky;
      top: 0;
      z-index: 30;
      display: flex;
      justify-content: flex-end;
      align-items: center;
      width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      padding: 18px 24px;
      border-bottom: 1px solid rgba(18, 54, 44, 0.12);
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 24px rgba(18, 54, 44, 0.04);
      transition: transform 0.25s ease, opacity 0.25s ease;
    }

    .portfolio-nav.hidden {
      transform: translateY(-120%);
      opacity: 0;
      pointer-events: none;
    }

    .nav-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 12px 18px;
      width: min(100%, 1180px);
      margin-left: auto;
      padding-right: clamp(12px, 4vw, 52px);
    }

    .nav-links a {
      color: rgba(18, 54, 44, 0.8);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      transition: color 0.2s ease;
    }

    .nav-links a:hover {
      color: #12362c;
    }

    .back-to-top {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 40;
      width: 52px;
      height: 52px;
      border: 1px solid rgba(18, 54, 44, 0.12);
      border-radius: 50%;
      background: #12362c;
      color: white;
      font-size: 1.8rem;
      line-height: 1;
      box-shadow: 0 14px 28px rgba(18, 54, 44, 0.2);
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(16px);
      transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
    }

    .back-to-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .back-to-top:hover {
      transform: translateY(-2px);
    }

    section[id] {
      scroll-margin-top: 100px;
    }

    .hero-panel {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 32px;
      align-items: center;
      padding: 32px;
      border: 1px solid rgba(18, 54, 44, 0.12);
      border-radius: 32px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(233, 242, 236, 0.9));
      box-shadow: 0 28px 65px rgba(18, 54, 44, 0.08);
      animation: fadeUp 0.8s ease-out both;
    }

    .hero-copy {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .eyebrow {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      border: 1px solid rgba(18, 54, 44, 0.12);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.8);
      padding: 8px 14px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #12362c;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 0.94;
      letter-spacing: -0.06em;
      color: #12362c;
    }

    h1 span {
      color: #2a5f4c;
    }

    .role {
      margin: 0;
      font-size: clamp(1.2rem, 2vw, 2rem);
      font-weight: 600;
      color: #2a5f4c;
    }

    .bio {
      max-width: 620px;
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.75;
      color: rgba(18, 54, 44, 0.76);
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      padding-top: 8px;
    }

    .primary-button,
    .secondary-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 0.85rem 1.35rem;
      font-weight: 700;
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      animation: fadeUp 0.9s ease-out both;
    }

    .primary-button {
      background: #12362c;
      color: white;
      box-shadow: 0 12px 24px rgba(18, 54, 44, 0.18);
    }

    .secondary-button {
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(18, 54, 44, 0.12);
      color: #12362c;
    }

    .primary-button:hover,
    .secondary-button:hover {
      transform: translateY(-1px);
    }

    .profile-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 20px;
      border-radius: 30px;
      background: linear-gradient(180deg, #12362c 0%, #1d4d3d 100%);
      box-shadow: 0 14px 32px rgba(18, 54, 44, 0.2);
      animation: floatIn 0.9s ease-out both;
    }

    .photo-placeholder {
      width: 100%;
      max-width: 420px;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: 22px;
      border: 1px dashed rgba(255, 255, 255, 0.45);
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04));
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.82rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-align: center;
      padding: 0;
      margin: 0 auto;
    }

    .photo-placeholder img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }

    .photo-placeholder:hover img {
      transform: scale(1.04);
    }

    .mini-metrics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .mini-metrics div {
      display: flex;
      flex-direction: column;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.08);
      padding: 14px 16px;
      color: white;
    }

    .mini-metrics strong {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.05em;
    }

    .mini-metrics span {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.8;
    }

    .content-section {
      margin-top: 56px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .content-section.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .reveal-item {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .reveal-item.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .experience-list {
      display: grid;
      gap: 18px;
    }

    .experience-item {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 20px;
      padding: 22px 20px;
      border: 1px solid rgba(18, 54, 44, 0.12);
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 18px 30px rgba(18, 54, 44, 0.03);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .experience-item:hover,
    .skill-card:hover,
    .contact-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 34px rgba(18, 54, 44, 0.08);
    }

    .experience-meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
      color: #12362c;
    }

    .experience-period {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #2a5f4c;
    }

    .experience-company {
      font-size: 0.9rem;
      color: rgba(18, 54, 44, 0.72);
    }

    .experience-item h3 {
      margin: 0 0 8px;
      font-size: 1.25rem;
      color: #12362c;
    }

    .experience-item p {
      margin: 0;
      line-height: 1.7;
      color: rgba(18, 54, 44, 0.75);
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(2rem, 3vw, 2.6rem);
      letter-spacing: -0.05em;
      color: #12362c;
    }

    .section-heading p {
      margin: 6px 0 0;
      color: rgba(18, 54, 44, 0.7);
    }

    .projects-grid {
      display: grid;
      gap: 18px;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .skill-card {
      padding: 22px 20px;
      border: 1px solid rgba(18, 54, 44, 0.12);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 18px 30px rgba(18, 54, 44, 0.03);
    }

    .skill-card h3 {
      margin: 0 0 16px;
      font-size: 0.82rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #2a5f4c;
    }

    .skill-card ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .skill-card li {
      display: flex;
      align-items: center;
      gap: 10px;
      color: rgba(18, 54, 44, 0.8);
    }

    .skill-card li span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #12362c;
      box-shadow: 0 0 0 4px rgba(18, 54, 44, 0.08);
    }

    .contact-card {
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 24px;
      border: 1px solid rgba(18, 54, 44, 0.12);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 18px 30px rgba(18, 54, 44, 0.03);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .contact-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(18, 54, 44, 0.08);
      padding-bottom: 12px;
    }

    .contact-row:last-of-type {
      border-bottom: none;
      padding-bottom: 0;
    }

    .contact-label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #2a5f4c;
    }

    .contact-row a {
      color: #12362c;
      text-decoration: none;
      font-weight: 600;
    }

    .contact-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      padding-top: 6px;
    }

    .site-footer {
      margin-top: 60px;
      padding-top: 24px;
      border-top: 1px solid rgba(18, 54, 44, 0.12);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      color: rgba(18, 54, 44, 0.7);
      font-size: 0.8rem;
    }

    .footer-links {
      display: flex;
      gap: 18px;
    }

    .footer-links a {
      color: #12362c;
      text-decoration: none;
    }

    @media (max-width: 900px) {
      .hero-panel,
      .projects-grid,
      .skills-grid {
        grid-template-columns: 1fr;
      }

      .hero-panel {
        padding: 22px;
      }

      .photo-placeholder {
        min-height: 320px;
      }

      .site-footer {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    const revealSections = document.querySelectorAll('.reveal-section');
    const revealItems = document.querySelectorAll('.reveal-item');

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.12,
      rootMargin: '0px 0px -30px 0px'
    });

    revealSections.forEach((section) => revealObserver.observe(section));
    revealItems.forEach((item) => revealObserver.observe(item));

    const nav = document.querySelector('.portfolio-nav');
    const backToTopButton = document.querySelector('.back-to-top');

    const updateHeaderVisibility = () => {
      const scrolled = window.scrollY > 120;

      nav?.classList.toggle('hidden', scrolled);
      backToTopButton?.classList.toggle('visible', scrolled);
    };

    updateHeaderVisibility();
    window.addEventListener('scroll', updateHeaderVisibility, { passive: true });

    backToTopButton?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</Layout>