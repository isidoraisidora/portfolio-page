---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Software Engineer Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Isidora Kuzmanovska | Portfolio</title>
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Charis+SIL:wght@400;700&display=swap');
      @import "tailwindcss";

      :root {
        --font-body: "Charis SIL", "Georgia", serif;
        --font-display: "Charis SIL", "Georgia", serif;
      }

      html {
        font-family: var(--font-body);
      }

      body {
        font-family: var(--font-body);
      }

      h1,
      h2,
      h3,
      .nav-links a,
      .eyebrow,
      .role,
      .experience-period,
      .contact-label,
      .mini-metrics strong {
        font-family: var(--font-display);
      }
    </style>
  </head>
  <body class="bg-slate-20 min-h-screen">
    <slot />
  </body>
</html>